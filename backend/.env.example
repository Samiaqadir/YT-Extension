PORT=4000
NODE_ENV=development
JWT_SECRET=flow-session-share-super-secret-key-change-in-prod-2025
GATEWAY_PUBLIC_URL=http://localhost:4000
FRONTEND_PORTAL_URL=http://localhost:4000/portal

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flow_sessions
# If DATABASE_URL is not accessible, the server automatically uses local SQLite fallback for seamless development
USE_SQLITE_FALLBACK=true
