{
  "manifest_version": 3,
  "name": "Flow Session Share",
  "version": "1.0.0",
  "description": "Secure, encrypted website session delegation without exposing passwords or raw cookies.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Flow Session Share"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "cookies",
    "notifications",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://*/*",
    "https://yt-extension-vercel-admin.vercel.app/*",
    "http://localhost:4000/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>", "https://yt-extension-vercel-admin.vercel.app/*", "http://localhost:4000/*", "http://*/*", "https://*/*"],
      "js": ["assets/content.js"],
      "run_at": "document_end"
    }
  ]
}
