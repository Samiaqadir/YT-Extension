{
  "name": "flow-session-share-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Flow Session Share - Secure Chrome Extension & Session Delegation Gateway",
  "scripts": {
    "build": "node scripts/sync-public.js",
    "sync": "node scripts/sync-public.js",
    "start:backend": "cd backend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "build:backend": "cd backend && npm run build",
    "test:backend": "cd backend && node dist/test-e2e.js",
    "build:extension": "cd extension && npm run build",
    "build:all": "npm run build:backend && npm run build:extension"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "sqlite3": "^5.1.7",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
